import("//build/test.gni")

config("multi_instance_test_probe_config") {
  visibility = [ ":*" ]
  include_dirs = [
    "include",
    "//foundation/systemabilitymgr/safwk/services/safwk/include",
  ]
}

ohos_shared_library("multi_instance_test_probe") {
  sources = [
    "src/multi_instance_test_probe.cpp",
    "src/multi_instance_test_probe_stub.cpp",
  ]
  configs = [ ":multi_instance_test_probe_config" ]

  deps = [ "//foundation/systemabilitymgr/safwk/interfaces/innerkits/safwk:system_ability_fwk" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "samgr:samgr_proxy",
  ]

  part_name = "safwk"
  subsystem_name = "systemabilitymgr"
}

group("multi_instance_test_probe_deploy") {
  deps = [ ":multi_instance_test_probe" ]
}
